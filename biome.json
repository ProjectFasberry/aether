{
	"$schema": "https://biomejs.dev/schemas/2.2.4/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true,
		"defaultBranch": "main"
	},
	"files": {
		"ignoreUnknown": false,
		"includes": ["**"]
	},
	"formatter": {
		"enabled": true,
		"lineWidth": 120,
		"indentStyle": "tab",
		"indentWidth": 2
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"nursery": {
				"useSortedClasses": "off"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"enabled": false,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": ["pkgs/shared/**"],
			"formatter": {
				"enabled": false
			},
			"linter": {
				"enabled": false
			}
		},
		{
			"includes": ["apps/api-main/**"],
			"javascript": {
				"jsxRuntime": "transparent"
			},
			"formatter": {
				"enabled": false
			},
			"linter": {
				"enabled": true,
				"rules": {
					"complexity": {
						"useLiteralKeys": "off",
						"noBannedTypes": "off",
						"useOptionalChain": "off",
						"noUselessCatch": "off",
						"noUselessSwitchCase": "off"
					},
					"style": {
						"useTemplate": "off",
						"noNonNullAssertion": "off"
					},
					"correctness": {
						"noUnusedVariables": "off",
						"noUnusedImports": "off",
						"noUnusedFunctionParameters": "off",
						"noEmptyPattern": "off"
					},
					"suspicious": {
						"noExplicitAny": "off"
					}
				}
			}
		},
		{
			"includes": ["apps/api-panel/**"],
			"javascript": {
				"jsxRuntime": "transparent"
			},
			"formatter": {
				"enabled": false
			},
			"linter": {
				"enabled": true,
				"rules": {
					"complexity": {
						"useLiteralKeys": "off",
						"noBannedTypes": "off",
						"useOptionalChain": "off",
						"noUselessCatch": "off",
						"noUselessSwitchCase": "off"
					},
					"style": {
						"useTemplate": "off",
						"noNonNullAssertion": "off"
					},
					"correctness": {
						"noUnusedVariables": "off",
						"noUnusedImports": "off",
						"noUnusedFunctionParameters": "off",
						"noEmptyPattern": "off"
					},
					"suspicious": {
						"noExplicitAny": "off"
					}
				}
			}
		}
	]
}
