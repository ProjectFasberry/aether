{
	"$schema": "https://biomejs.dev/schemas/2.2.4/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true,
		"defaultBranch": "main"
	},
	"files": {
		"ignoreUnknown": false,
		"includes": ["**"]
	},
	"formatter": {
		"enabled": true,
		"lineWidth": 120,
		"indentStyle": "tab",
		"indentWidth": 2
	},
	"linter": {
		"enabled": false
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"enabled": false,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": ["pkgs/config-drizzle/**"],
			"formatter": {
				"enabled": false
			}
		},
		{
			"includes": ["pkgs/shared/**"],
			"formatter": {
				"enabled": false
			}
		},
		{
			"includes": ["pkgs/core/**"],
			"formatter": {
				"enabled": false
			}
		},
		{
			"includes": ["apps/thunderbird/**"],
			"javascript": {
				"jsxRuntime": "transparent"
			},
			"formatter": {
				"enabled": false
			}
		},
		{
			"includes": ["apps/glaux/**"],
			"javascript": {
				"jsxRuntime": "transparent"
			},
			"formatter": {
				"enabled": false
			}
		}
	]
}
