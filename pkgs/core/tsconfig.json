{
	"extends": "@repo/config-typescript/base.json",
	"compilerOptions": {
		"jsx": "react-jsx",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"skipLibCheck": true,
		"composite": true,
		"emitDeclarationOnly": true,
		"noUncheckedIndexedAccess": false,
		"noPropertyAccessFromIndexSignature": true,
		"declaration": true,
		"strict": true,
		"types": ["bun-types"],
		"declarationMap": true,
		"incremental": true,
		"outDir": "dist",
		"rootDir": ".",
		"paths": {
			"@gen/*": ["../shared/.out/*"]
		}
	},
	"exclude": [
		"dist",
		"node_modules"
	],
	"include": [
		"./src/**/*",
		"./**/*.d.ts"
	],
	"references": [
		{
			"path": "../shared"
		}
	]
}
