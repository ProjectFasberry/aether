{
	"extends": "@repo/config-typescript/base.json",
	"compilerOptions": {
		"jsx": "react-jsx",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"skipLibCheck": true,
		"composite": true,
		"emitDeclarationOnly": true,
		"noPropertyAccessFromIndexSignature": true,
		"declaration": true,
		"types": ["bun-types"],
		"rootDir": ".",
		"strict": true,
		"declarationMap": true,
		"incremental": true,
		"outDir": "dist",
		"paths": {
			"@gen/*": ["./.out/*"]
		}
	},
	"exclude": ["dist", "node_modules"],
	"include": ["./**/*.ts", "./**/*.tsx", "./.out/**/*.ts"]
}
