{
	"name": "panel",
	"version": "1.0.0",
	"private": true,
	"license": "MIT",
	"type": "module",
	"scripts": {
		"test": "echo \"Error: no test specified\" && exit 1",
		"dev": "infisical run --env=dev --path=/panel -- bun run --watch src/index.ts",
		"build": "STAGE=staging bun run ./scripts/build.ts",
		"build:prod": "STAGE=prod bun run ./scripts/build.ts",
		"start": "infisical run --env=prod --path=/panel -- bun run ./dist/index.js",
		"----------------": "",
		"lint": "bunx biome lint",
		"type-check": "tsc --build",
		"circular-check": "bunx dpdm --no-warning ./src/index.ts",
		"------------------": "",
		"build:image:prod": "infisical run --env=common --path=/root -- make build",
		"build:image:tag": "infisical run --env=common --path=/root -- make tag",
		"build:image:push": "infisical run --env=common --path=/root -- make push",
		"--------------------": "",
		"release:prod": "infisical run --env=common --path=/root -- make all STAGE=prod NAME=api-panel",
		"release:staging": "infisical run --env=common --path=/root -- make all STAGE=staging NAME=api-panel"
	},
	"dependencies": {
		"@elysia/bearer": "1.4.4",
		"@elysia/cors": "1.4.2",
		"@nats-io/jetstream": "3.2.0",
		"@nats-io/nats-core": "3.2.0",
		"@nats-io/transport-node": "3.2.0",
		"@repo/shared": "workspace:*",
		"consola": "3.4.2",
		"croner": "9.1.0",
		"elysia": "1.4.28",
		"elysia-ip": "1.1.0",
		"gramio": "0.6.0",
		"ioredis": "5.6.1",
		"ky": "2.0.2",
		"mysql2": "3.14.1",
		"kysely": "0.28.2",
		"modern-rcon": "1.0.3",
		"@tqman/nice-logger": "1.1.1",
		"pg": "8.13.1",
		"yaml": "2.8.3",
		"zod": "4.2.1"
	},
	"devDependencies": {
		"bun-types": "1.2.17",
		"@types/pg": "8.11.10",
		"typescript": "~5.8.3"
	}
}
