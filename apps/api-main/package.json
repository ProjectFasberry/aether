{
	"name": "api-main",
	"version": "1.0.0",
	"private": true,
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "infisical run --env=dev --path=/backend -- bun run --watch ./src/index.ts",
		"build": "STAGE=staging bun run ./scripts/build.ts",
		"build:prod": "STAGE=prod bun run ./scripts/build.ts",
		"start:dev": "infisical run --env=dev --path=/backend -- bun run ./dist/index.js",
		"start:prod": "infisical run --env=prod --path=/backend -- bun run ./dist/index.js",
		"-------------": "",
		"type-check": "tsc --build",
		"lint": "bunx biome lint",
		"circular-check": "bunx dpdm --no-warning ./src/index.ts",
		"-------------------": "",
		"build:image:prod": "infisical run --env=common --path=/root -- make build",
		"build:image:tag": "infisical run --env=common --path=/root -- make tag",
		"build:image:push": "infisical run --env=common --path=/root -- make push",
		"--------------------": "",
		"release:prod": "infisical run --env=common --path=/root -- make all STAGE=prod NAME=api-main",
		"release:staging": "infisical run --env=common --path=/root -- make all STAGE=staging NAME=api-main"
	},
	"dependencies": {
		"@elysia/bearer": "1.4.4",
		"@elysia/cors": "1.4.2",
		"@elysia/openapi": "1.4.15",
		"@elysia/server-timing": "1.4.1",
		"@napi-rs/canvas": "0.1.97",
		"@nats-io/jetstream": "3.2.0",
		"@nats-io/nats-core": "3.2.0",
		"@nats-io/transport-node": "3.2.0",
		"@oslojs/crypto": "1.0.1",
		"@oslojs/encoding": "1.1.0",
		"@repo/core": "workspace:*",
		"@repo/shared": "workspace:*",
		"@scure/bip39": "2.0.1",
		"@sinclair/typebox": "0.34.49",
		"@tqman/nice-logger": "1.1.1",
		"bcryptjs": "3.0.2",
		"bowser": "2.13.1",
		"croner": "9.1.0",
		"dayjs": "1.11.11",
		"elysia": "1.4.28",
		"elysia-ip": "1.1.0",
		"ioredis": "5.6.1",
		"ky": "2.0.2",
		"kysely": "0.28.2",
		"kysely-mariadb": "0.1.2",
		"kysely-paginate": "0.3.1",
		"minio": "8.0.7",
		"modern-rcon": "1.0.3",
		"mysql2": "3.14.1",
		"nanoid": "5.1.5",
		"p-limit": "7.1.1",
		"pg": "8.13.1",
		"zod": "4.2.1"
	},
	"devDependencies": {
		"@types/pg": "8.11.10",
		"bun-types": "1.2.17",
		"typescript": "~5.8.3"
	}
}
