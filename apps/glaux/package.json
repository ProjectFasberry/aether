{
	"name": "glaux",
	"version": "1.0.0",
	"private": true,
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "infisical run --env=dev --path=/glaux -- bun --env-file=.env.local run --watch ./src/index.ts",
		"build": "STAGE=staging bun run ./scripts/build.ts",
		"build:prod": "STAGE=prod bun run ./scripts/build.ts",
		"start:dev": "infisical run --env=dev --path=/glaux -- bun run ./dist/index.js",
		"start:prod": "infisical run --env=prod --path=/backend -- bun run ./dist/index.js",
		"----------------": "",
		"lint": "bunx biome lint",
		"type-check": "tsc --build",
		"circular-check": "bunx dpdm --no-warning ./src/index.ts",
		"------------------": "",
		"build:image:prod": "infisical run --env=common --path=/root -- make build",
		"build:image:tag": "infisical run --env=common --path=/root -- make tag",
		"build:image:push": "infisical run --env=common --path=/root -- make push",
		"--------------------": "",
		"release:prod": "bun run type-check && infisical run --env=common --path=/root -- make all STAGE=prod NAME=glaux",
		"release:staging": "bun run type-check && infisical run --env=common --path=/root -- make all STAGE=staging NAME=glaux"
	},
	"dependencies": {
		"@elysia/bearer": "1.4.4",
		"@elysia/cors": "1.4.2",
		"@elysia/html": "^1.4.1",
		"@elysia/openapi": "1.4.15",
		"@nats-io/jetstream": "3.2.0",
		"@nats-io/nats-core": "3.2.0",
		"@nats-io/transport-node": "3.2.0",
		"@repo/core": "workspace:*",
		"@repo/shared": "workspace:*",
		"@sinclair/typebox": "0.34.49",
		"@tqman/nice-logger": "1.1.1",
		"croner": "9.1.0",
		"elysia": "1.4.28",
		"elysia-ip": "1.1.0",
		"gramio": "0.6.0",
		"ioredis": "5.6.1",
		"kysely": "0.28.2",
		"minio": "8.0.7",
		"modern-rcon": "1.0.3",
		"mysql2": "3.14.1",
		"pg": "8.13.1",
		"typebox": "1.1.39",
		"yaml": "2.8.3"
	},
	"devDependencies": {
		"bun-types": "1.2.17",
		"@types/pg": "8.11.10",
		"typescript": "~5.8.3"
	}
}
