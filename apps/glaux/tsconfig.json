{
	"compilerOptions": {
		"isolatedModules": true,
		"target": "esnext",
		"lib": ["esnext"],
		"moduleDetection": "force",
		"module": "preserve",
		"moduleResolution": "bundler",
		"types": ["bun-types"],
		"allowJs": true,
		"verbatimModuleSyntax": false,
		"resolveJsonModule": true,
		"declaration": true,
		"declarationMap": true,
		"composite": true,
		"incremental": true,
		"rootDir": ".",
		"emitDeclarationOnly": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"outDir": "dist",
		"skipLibCheck": true,
		"noEmit": true,
		"paths": {
			"#/*": ["./src/*"],
			"@repo/shared/*": ["../../pkgs/src/*"],
			"@repo/core/*": ["../../pkgs/core/src/*"]
		}
	},
	"include": ["src/**/*", "scripts/**/*"],
	"exclude": ["node_modules", "dist"],
	"references": [
		{
			"path": "../../pkgs/shared"
		},
		{
			"path": "../../pkgs/core"
		}
	]
}
