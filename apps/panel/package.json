{
	"name": "panel",
	"version": "1.0.0",
	"private": true,
	"license": "MIT",
	"type": "module",
	"module": "src/index.js",
	"scripts": {
		"test": "echo \"Error: no test specified\" && exit 1",
		"dev": "infisical run --env=dev --path=/panel -- bun run --watch src/index.ts",
		"build": "bun build ./src/index.ts --target=bun --outdir=./dist --metafile=./dist/meta.json",
		"start": "infisical run --env=prod --path=/panel -- bun run ./dist/index.js",
		"lint": "bunx biome lint",
		"type-check": "tsc --noEmit",
		"------------------": "",
		"build:prod": "make build",
		"build:tag": "make tag",
		"build:push": "make push",
		"release": "make all"
	},
	"dependencies": {
		"@elysiajs/bearer": "1.4.1",
		"@elysiajs/cors": "1.4.0",
		"elysia-http-status-code": "1.0.9",
		"elysia-ip": "1.0.10",
		"consola": "3.4.2",
		"@repo/shared": "workspace:*",
		"croner": "9.1.0",
		"@bogeychan/elysia-logger": "0.1.10",
		"@nats-io/jetstream": "3.2.0",
		"@nats-io/nats-core": "3.2.0",
		"@nats-io/transport-node": "3.2.0",
		"elysia": "1.4.16",
		"ioredis": "5.6.1",
		"ky": "1.14.0",
		"gramio": "0.4.9",
		"kysely": "0.28.2",
		"pg": "8.13.1",
		"yaml": "2.8.3"
	},
	"devDependencies": {
		"bun-types": "1.2.17",
		"@types/pg": "8.11.10"
	}
}
