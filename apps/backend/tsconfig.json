{
	"compilerOptions": {
		"isolatedModules": true,
		"target": "esnext",
		"lib": ["esnext"],
		"moduleDetection": "force",
		"module": "preserve",
		"moduleResolution": "bundler",
		"types": ["bun-types"],
		"allowJs": true,
		"verbatimModuleSyntax": false,
		"resolveJsonModule": true,
		"declaration": true,
		"declarationMap": true,
		"composite": true,
		"incremental": true,
		"rootDir": ".",
		"emitDeclarationOnly": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"skipLibCheck": true,
		"outDir": "dist",
		"paths": {
			"#/*": ["./src/*"],
			"@repo/shared/*": ["../../packages/shared/*"]
		}
	},
	"include": ["src/**/*", "imports.ts", "drizzle.config.ts", "env.d.ts", "declare.d.ts"],
	"exclude": ["node_modules", "dist", "./src/drizzle"],
	"references": [
		{ 
			"path": "../../packages/shared" 
		}
	]
}
